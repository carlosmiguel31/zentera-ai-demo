# =============================================================================
# Zentera AI Demo — variáveis de ambiente
# Copie para `.env` e preencha. O arquivo `.env` NUNCA vai para o repositório.
# =============================================================================

# -----------------------------------------------------------------------------
# PRIVADO — só existe no processo Node. Nada aqui chega ao navegador.
# -----------------------------------------------------------------------------

# Endpoint da aplicação Zentera.
# Em produção, landing e aplicação ficam na mesma VPS, então o acesso é por
# loopback — o IP público não aparece em lugar nenhum do código.
AI_WEBHOOK_URL=http://127.0.0.1:3001/api/integrations/generic-webhook/incoming

# Autenticação do webhook Zentera.
# Hoje está desativada, então pode ficar vazio. Quando for ativada, basta
# preencher e reiniciar o processo: o header `Authorization: Bearer <valor>`
# passa a ser enviado automaticamente. Vazio = header não enviado.
AI_WEBHOOK_SECRET=

# `tenantId` exigido pelo contrato da aplicação Zentera.
ZENTERA_DEMO_TENANT_ID=empresa_demo

# Tempo máximo de espera pela resposta da Zentera, em milissegundos.
AI_REQUEST_TIMEOUT_MS=30000

# Limite comercial: mensagens do visitante por sessão.
DEMO_MAX_MESSAGES=15

# Tamanho máximo de cada mensagem, em caracteres.
DEMO_MAX_MESSAGE_LENGTH=1500

# Rate limit por IP + sessão (20 mensagens a cada 10 minutos).
DEMO_RATE_LIMIT_MAX=20
DEMO_RATE_LIMIT_WINDOW_MS=600000

# -----------------------------------------------------------------------------
# PÚBLICO — chega ao bundle do navegador.
#
# O Vite só expõe ao browser variáveis com o prefixo `VITE_`. Por isso os
# valores públicos usam `VITE_PUBLIC_*`: são exatamente os `PUBLIC_SITE_URL` e
# `PUBLIC_MAIN_SITE_URL` do briefing, com o prefixo que o framework exige.
#
# NUNCA coloque segredo em uma variável `VITE_*`.
# -----------------------------------------------------------------------------

VITE_PUBLIC_SITE_URL=https://teste.zenteravirtua.com.br
VITE_PUBLIC_MAIN_SITE_URL=https://zenteravirtua.com.br

# Devem ter o mesmo valor de DEMO_MAX_MESSAGES / DEMO_MAX_MESSAGE_LENGTH.
# O servidor é quem manda; estes valores só ajustam a experiência na tela.
VITE_DEMO_MAX_MESSAGES=15
VITE_DEMO_MAX_MESSAGE_LENGTH=1500

# -----------------------------------------------------------------------------
# PRODUÇÃO (VPS)
# -----------------------------------------------------------------------------
# HOST=127.0.0.1
# PORT=3200
